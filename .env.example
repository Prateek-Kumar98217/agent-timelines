# Copy this file to .env, which git ignores, and fill in what you need.
#   cp .env.example .env
# Docker Compose reads .env automatically. Restart the stack after changing it.

# ----------------------------------------------------------------------------------------
# Needed: the key to add now
# ----------------------------------------------------------------------------------------

# The Gemini key for the DeepEval judge, used only by evals/judge.py. It sends task text and
# answers to Google, so check the free tier's data terms first.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ----------------------------------------------------------------------------------------
# Keys that don't go in this file
# ----------------------------------------------------------------------------------------

# To run tasks on Groq, Gemini or OpenRouter, add your key on the API keys page of the web app
# at http://127.0.0.1:3001/keys. It's stored encrypted, and a key put in this file isn't used.
#
# AWS, Supabase and GitHub sign-in keys aren't listed because nothing reads them yet. They
# arrive with the deployed build.

# ----------------------------------------------------------------------------------------
# Optional: running models on this machine with Ollama
# ----------------------------------------------------------------------------------------

# Remove the # from these to run tasks on your GPU with no API key. The first start downloads
# the model, which is about 2.5 GB.
# COMPOSE_PROFILES=ollama
# APP_OLLAMA_URL=http://ollama:11434
# APP_DEFAULT_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_CONTEXT_LENGTH=8192

# ----------------------------------------------------------------------------------------
# Optional: limits, shown with their defaults
# ----------------------------------------------------------------------------------------

# APP_LOCAL_ACTIVE_BRANCHES=5
# APP_LOCAL_TOKENS_PER_DAY=200000
# APP_MAX_QUEUED_BRANCHES=100

# ----------------------------------------------------------------------------------------
# Optional: local passwords, which only matter if you expose these services
# ----------------------------------------------------------------------------------------

# POSTGRES_USER=timelines
# POSTGRES_PASSWORD=timelines-local
# POSTGRES_DB=timelines
# SEARXNG_SECRET=local-only-not-exposed
